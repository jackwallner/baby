{
  "app": "baby",
  "display_name": "Baby Tracker",
  "target": "iphone_69",
  "copy_contract": "single-header-benefit-story-v3",
  "health_app": true,
  "market": {
    "category": "newborn feed, diaper and sleep trackers",
    "audience": "parents in the first weeks, handing the baby back and forth at 3am",
    "problem": "At 3am the question is when she last ate and which side, and the category's biggest apps answer it through ad banners, AI panels and buttons that move between updates",
    "advantage": "One calm logging screen for feeds, diapers and sleep, with full history one tap away and optional reports tucked into More",
    "competitive_context": "An Apple Watch companion is common in the category. The difference is stable logging controls with no ads and no AI, with day-of-life diaper counts and a doctor-ready summary available in More",
    "search_intent": [
      "newborn tracker",
      "diaper tracker",
      "baby log",
      "breastfeeding tracker"
    ],
    "proof_points": [
      {
        "claim": "The home card shows Last feed, 2h 13m ago, and Left breast",
        "source": "capture/01_now.png"
      },
      {
        "claim": "Tapping Feed, Left logs the feed and shows Undo",
        "source": "capture/02_log.png"
      },
      {
        "claim": "History shows today at 3 wet, 3 dirty, 5 feeds and 3h 45m sleep",
        "source": "capture/05_history.png"
      },
      {
        "claim": "Day three shows the logged diaper counts beside the labeled breastfeeding reference of 3+ wet and 2+ dirty",
        "source": "capture/03_first_weeks.png"
      },
      {
        "claim": "The summary page lists daily feeds, wet and dirty counts, sleep and weights",
        "source": "capture/04_summary.png"
      },
      {
        "claim": "The Wake control shows Asleep with the elapsed time",
        "source": "capture/06_sleep.png"
      }
    ]
  },
  "capture_report": "capture/capture-report.json",
  "theme": {
    "background": "#f5f0e8",
    "background_2": "#e8ded0",
    "icon_source": "../Baby/Assets.xcassets/AppIcon.appiconset/icon_1024.png",
