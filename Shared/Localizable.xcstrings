          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prezzi sono indicati nella tua valuta prima dell'acquisto. Gli abbonamenti si rinnovano automaticamente fino alla disdetta. %@"
