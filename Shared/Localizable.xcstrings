    "Enzymes in ordinary laundry detergent break down protein. Rub a little straight into the damp stain and leave it fifteen minutes before washing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enzyme in normalem Waschmittel bauen Eiweiß ab. Reibe etwas davon direkt in den feuchten Fleck und lass es vor dem Waschen 15 Minuten einwirken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enzymes in ordinary laundry detergent break down protein. Rub a little straight into the damp stain and leave it fifteen minutes before washing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las enzimas del detergente común para ropa descomponen las proteínas. Frota un poco directamente sobre la mancha húmeda y déjalo actuar quince minutos antes de lavar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli enzimi del normale detersivo per bucato scompongono le proteine. Strofinane un po' direttamente sulla macchia umida e lascia agire per quindici minuti prima di lavare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As enzimas do sabão comum para roupas decompõem proteínas. Esfregue um pouco diretamente na mancha úmida e deixe agir por quinze minutos antes de lavar."
          }
        }
      }
    },
