    "Baby Tracker is a log, not medical advice." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baby Tracker ist ein Protokoll und ersetzt keine medizinische Beratung."
          }
        },
        "en" : {
          "stringUnit" : {
