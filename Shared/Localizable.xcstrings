    "Waiting on Apple to confirm this purchase. Baby+ turns on by itself as soon as it goes through, so there is nothing to tap again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple bestätigt den Kauf noch. Sobald er abgeschlossen ist, wird Baby+ automatisch aktiviert. Du musst nichts weiter tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting on Apple to confirm this purchase. Baby+ turns on by itself as soon as it goes through, so there is nothing to tap again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando que Apple confirme la compra. Baby+ se activará automáticamente cuando se complete, no necesitas tocar nada más."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa della conferma di Apple. Baby+ si attiverà automaticamente appena l’acquisto sarà completato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando a Apple confirmar a compra. O Baby+ será ativado automaticamente assim que ela for concluída. Não é preciso tocar novamente."
          }
        }
      }
    },
