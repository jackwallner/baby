    "One part white vinegar to four parts cool water, thirty minutes, then rinse. This is for the smell that survives the wash, not for the mark." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil heller Essig auf vier Teile kaltes Wasser, 30 Minuten einweichen, dann ausspülen. Das hilft gegen Geruch nach dem Waschen, nicht gegen den Fleck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One part white vinegar to four parts cool water, thirty minutes, then rinse. This is for the smell that survives the wash, not for the mark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte de vinagre blanco por cuatro partes de agua fría. Deja actuar treinta minutos y enjuaga. Es para el olor que queda después del lavado, no para la mancha."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte di aceto bianco e quattro di acqua fresca, per trenta minuti, poi risciacqua. Serve per l'odore che resta dopo il lavaggio, non per la macchia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma parte de vinagre branco para quatro de água fria. Deixe por 30 minutos e enxágue. Isso ajuda com o cheiro que fica após a lavagem, não com a mancha."
          }
        }
      }
    },
