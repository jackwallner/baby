    "Night light uses dim, warm colors that are easier on the eyes during feeds in a dark room." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Nachtlicht nutzt gedämpfte, warme Farben, die bei Mahlzeiten im Dunkeln angenehmer für die Augen sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night light uses dim, warm colors that are easier on the eyes during feeds in a dark room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz nocturna usa colores cálidos y tenues, más cómodos para la vista durante las tomas en una habitación oscura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luce notturna usa colori tenui e caldi, più riposanti per gli occhi durante le poppate al buio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz noturna usa cores suaves e quentes, mais confortáveis para os olhos nas mamadas no escuro."
          }
        }
      }
    },
