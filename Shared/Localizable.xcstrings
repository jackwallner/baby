          "stringUnit" : {
            "state" : "translated",
            "value" : "No chlorine bleach on baby clothes here, and never mix hydrogen peroxide or vinegar with anything else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No uses cloro en la ropa del bebé y nunca mezcles agua oxigenada ni vinagre con ningún otro producto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non usare candeggina al cloro sui vestiti del bambino e non mescolare mai acqua ossigenata o aceto con altre sostanze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não use água sanitária nas roupas do bebê e nunca misture água oxigenada ou vinagre com outras substâncias."
          }
        }
      }
    },
