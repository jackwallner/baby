    "Gap: longest time between two logged feeds, start to start. Longest: longest single sleep. Only what was logged is counted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstand: längste Zeit zwischen dem Beginn zweier eingetragener Mahlzeiten. Längster Schlaf: längste einzelne Schlafphase. Es zählt nur, was eingetragen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gap: longest time between two logged feeds, start to start. Longest: longest single sleep. Only what was logged is counted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalo: tiempo más largo entre el inicio de dos tomas registradas. Más largo: período de sueño continuo más largo. Solo se cuenta lo registrado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervallo: tempo più lungo tra l'inizio di due poppate registrate. Più lungo: periodo di sonno singolo più lungo. Si conta solo ciò che è stato registrato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalo: maior tempo entre o início de duas mamadas registradas. Mais longo: maior período de sono. Apenas o que foi registrado é contado."
          }
        }
      }
    },
    "Gap: longest time between two logged feeds, start to start. Only what was logged is counted." : {
