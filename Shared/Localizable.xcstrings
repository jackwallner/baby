    "Invite your partner, a grandparent or a nanny. Everyone logs from their own iPhone into %@'s log, and every phone shows the latest feed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade deinen Partner oder deine Partnerin, einen Großelternteil oder eine Nanny ein. Alle nutzen ihr eigenes iPhone für Einträge im Protokoll von %@ und sehen die letzte Mahlzeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite your partner, a grandparent or a nanny. Everyone logs from their own iPhone into %@'s log, and every phone shows the latest feed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a tu pareja, a un abuelo o a una niñera. Cada quien registra desde su iPhone en el registro de %@, y todos los teléfonos muestran la última toma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita il tuo partner, un nonno o una tata. Ognuno registra dal proprio iPhone nel registro di %@ e su ogni telefono appare l'ultima poppata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convide seu parceiro ou parceira, um avô, uma avó ou uma babá. Cada pessoa registra pelo próprio iPhone no registro de %@, e todos os celulares mostram a última mamada."
          }
        }
      }
    },
