    "Dissolve the powder in warm water to the dose on the tub, submerge the garment, and leave it one to eight hours. This is the one that gets old stains out." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löse das Pulver nach Packungsangabe in warmem Wasser auf. Lege das Kleidungsstück hinein und lass es ein bis acht Stunden einweichen. Das entfernt alte Flecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dissolve the powder in warm water to the dose on the tub, submerge the garment, and leave it one to eight hours. This is the one that gets old stains out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disuelve el polvo en agua tibia según la dosis del envase, sumerge la prenda y déjala de una a ocho horas. Este producto elimina las manchas antiguas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sciogli la polvere in acqua tiepida seguendo la dose sulla confezione, immergi il capo e lascialo da una a otto ore. È il trattamento che rimuove le macchie vecchie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dissolva o pó em água morna na dose indicada na embalagem, mergulhe a peça e deixe de molho por uma a oito horas. Este é o produto que remove manchas antigas."
          }
        }
      }
    },
