    "Apple could not save that change. Your existing log is safe. Check your connection and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konnte die Änderung nicht speichern. Dein bisheriges Protokoll ist sicher. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple could not save that change. Your existing log is safe. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no pudo guardar el cambio. Tu registro está a salvo. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple non è riuscita a salvare la modifica. Il tuo registro è al sicuro. Controlla la connessione e riprova."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple não conseguiu salvar essa alteração. Seus registros estão seguros. Verifique sua conexão e tente novamente."
          }
        }
      }
    },
    "Asked once. The steps then skip anything you do not have, instead of sending you to the shop at 2am." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir fragen nur einmal. Danach überspringen die Schritte alles, was du nicht da hast. So musst du nachts nicht einkaufen gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asked once. The steps then skip anything you do not have, instead of sending you to the shop at 2am."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te lo preguntamos una vez. Luego, los pasos omiten lo que no tienes para que no tengas que salir a comprar a las 2 a. m."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te lo chiediamo una volta sola. I passaggi saltano ciò che non hai, senza mandarti a fare la spesa alle due di notte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntamos uma vez. Depois, as etapas pulam o que você não tem, sem precisar sair para comprar nada às 2h."
          }
        }
      }
    },
