        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La noche anterior a una consulta del recién nacido. Agrega la fecha de nacimiento en Configuración > Bebé o la fecha de la consulta en Configuración > Recordatorios."
          }
        },
        "it" : {
