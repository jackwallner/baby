          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reference covers days 1 to %lld. %@ is on day %lld, so the table is for looking back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La referencia abarca del día 1 al %lld. %@ está en el día %lld, así que la tabla sirve para consultar días anteriores."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riferimento copre i giorni da 1 a %lld. %@ è al giorno %lld, quindi la tabella serve per consultare i giorni passati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A referência cobre do dia 1 ao %lld. %@ está no dia %lld, então a tabela serve para consultar os dias anteriores."
          }
        }
      }
    },
