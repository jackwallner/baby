          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resumo para o pediatra, as tendências e a exportação estão liberados em todos os aparelhos com essa Conta Apple."
          }
        }
      }
    },
    "The reference covers days 1 to %lld. %@ is on day %lld, so the table is for looking back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
