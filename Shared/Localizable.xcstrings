    "That invite couldn't be opened. Check your connection and that iCloud is signed in, or ask for a new link if sharing was stopped. Your existing log is safe." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einladung konnte nicht geöffnet werden. Prüfe deine Verbindung und ob du bei iCloud angemeldet bist. Falls die Freigabe beendet wurde, bitte um einen neuen Link. Dein bisheriges Protokoll bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That invite couldn't be opened. Check your connection and that iCloud is signed in, or ask for a new link if sharing was stopped. Your existing log is safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir la invitación. Comprueba tu conexión y que hayas iniciado sesión en iCloud, o pide un enlace nuevo si se dejó de compartir. Tu registro está a salvo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire l’invito. Controlla la connessione e l’accesso a iCloud oppure, se la condivisione è stata interrotta, chiedi un nuovo link. Il tuo registro è al sicuro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir esse convite. Confira sua conexão e se a sessão do iCloud está iniciada, ou peça um novo link se o compartilhamento tiver sido interrompido. Seu registro continua seguro."
          }
        }
      }
    },
