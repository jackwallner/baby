    "On its own, in clean water. Never alongside peroxide or bleach." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einzeln in sauberem Wasser verwenden. Niemals zusammen mit Peroxid oder Bleiche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On its own, in clean water. Never alongside peroxide or bleach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsalo solo, en agua limpia. Nunca junto con agua oxigenada ni cloro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da solo, in acqua pulita. Mai insieme ad acqua ossigenata o candeggina."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use sozinho, em água limpa. Nunca junto com água oxigenada ou alvejante."
          }
        }
      }
    },
    "On the other iPhone, choose Join a shared log and scan this code" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle auf dem anderen iPhone „Gemeinsamem Protokoll beitreten“ und scanne diesen Code"
          }
        },
