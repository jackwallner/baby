    "Get it off the skin first, then peel the clothes downward if you can, not over the head." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne es zuerst von der Haut. Zieh die Kleidung dann möglichst nach unten aus, nicht über den Kopf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get it off the skin first, then peel the clothes downward if you can, not over the head."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero retira lo que haya en la piel. Luego, si puedes, quita la ropa hacia abajo sin pasarla por la cabeza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima toglilo dalla pelle, poi sfila i vestiti verso il basso, se riesci, senza passarli dalla testa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpe a pele primeiro. Depois, se puder, tire a roupa puxando para baixo, sem passar pela cabeça."
          }
        }
      }
    },
