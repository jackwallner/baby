    "The pediatrician summary, trends and export are unlocked on every device signed in to this Apple ID." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusammenfassung für die Kinderarztpraxis, Trends und Export sind auf allen Geräten mit dieser Apple-ID freigeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pediatrician summary, trends and export are unlocked on every device signed in to this Apple ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resumen para el pediatra, las tendencias y la exportación están disponibles en todos los dispositivos con esta cuenta de Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
