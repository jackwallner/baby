          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dab it on, wait ten minutes, rinse cold. Rinse off any earlier product before this one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplícala a toques, espera diez minutos y enjuaga con agua fría. Retira con agua cualquier producto anterior antes de aplicarla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampona, aspetta dieci minuti e risciacqua con acqua fredda. Prima risciacqua ogni prodotto usato in precedenza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique com leves batidas, espere dez minutos e enxágue com água fria. Enxágue qualquer produto anterior antes de aplicar este."
          }
        }
      }
    },
