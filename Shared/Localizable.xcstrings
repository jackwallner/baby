            "value" : "Vocês dois registram"
          }
        }
      }
    },
    "You logged on this phone before joining %@'s log. Moving them lets everyone see them, and removes your separate copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast auf diesem iPhone Einträge erstellt, bevor du dem Protokoll von %@ beigetreten bist. Wenn du sie verschiebst, können alle sie sehen und deine separate Kopie wird entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You logged on this phone before joining %@'s log. Moving them lets everyone see them, and removes your separate copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregaste registros en este teléfono antes de unirte al registro de %@. Al trasladarlos, todos podrán verlos y se eliminará tu copia separada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai registrato dei dati su questo telefono prima di unirti al registro di %@. Se sposti le registrazioni, tutti potranno vederle e la tua copia separata verrà rimossa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você fez registros neste celular antes de entrar no registro de %@. Ao movê-los, todos poderão vê-los, e sua cópia separada será removida."
          }
        }
      }
    },
    "You logged on this phone before joining the shared's log. Moving them lets everyone see them, and removes your separate copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast auf diesem iPhone Einträge erstellt, bevor du dem gemeinsamen Protokoll beigetreten bist. Wenn du sie verschiebst, können alle sie sehen und deine separate Kopie wird entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You logged on this phone before joining the shared's log. Moving them lets everyone see them, and removes your separate copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregaste registros en este teléfono antes de unirte al registro compartido. Al trasladarlos, todos podrán verlos y se eliminará tu copia separada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai registrato dei dati su questo telefono prima di unirti al registro condiviso. Se sposti le registrazioni, tutti potranno vederle e la tua copia separata verrà rimossa."
