    "On their phone: Settings, then Invite someone. A QR code appears." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem anderen iPhone: Einstellungen und dann „Jemanden einladen“ wählen. Ein QR-Code erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
