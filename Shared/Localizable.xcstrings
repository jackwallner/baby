    "The evening before a newborn visit, a note with what you have logged since the last one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend vor einem Untersuchungstermin für dein Neugeborenes eine Mitteilung mit allem, was du seit dem letzten Termin eingetragen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The evening before a newborn visit, a note with what you have logged since the last one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La noche anterior a una consulta del recién nacido, una nota con lo que registraste desde la última consulta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
