          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Se renueva automáticamente, salvo que canceles 24 h antes de que termine el período."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Si rinnova automaticamente se non annulli 24 ore prima della fine del periodo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Renovação automática, a menos que seja cancelada 24h antes do fim do período."
          }
        }
      }
    },
    "%@. Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Verlängert sich automatisch, wenn du nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums kündigst. Verwalten oder kündigen unter Einstellungen › Apple-ID › Abonnements."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Se renueva automáticamente, salvo que canceles al menos 24 horas antes de que termine el período actual. Administra o cancela en Configuración › Apple ID › Suscripciones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Si rinnova automaticamente, salvo disdetta almeno 24 ore prima della fine del periodo in corso. Gestisci o disdici in Impostazioni › ID Apple › Abbonamenti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Renova automaticamente, a menos que seja cancelado pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele em Ajustes › Conta Apple › Assinaturas."
          }
        }
      }
    },
