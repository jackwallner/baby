    "Walk into the pediatrician\nwith a clean summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einer klaren Übersicht\nin die Kinderarztpraxis"
