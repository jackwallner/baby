    "Check the care label first, and never put two products on the fabric in the same step. Rinse in between." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe zuerst das Pflegeetikett und gib nie zwei Mittel gleichzeitig auf den Stoff. Spüle dazwischen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the care label first, and never put two products on the fabric in the same step. Rinse in between."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa primero la etiqueta de cuidado y nunca apliques dos productos a la tela en el mismo paso. Enjuaga entre uno y otro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
