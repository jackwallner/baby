    "You and another caregiver logging into one shared baby log" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du und eine weitere Betreuungsperson tragt gemeinsam in ein Protokoll für euer Baby ein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You and another caregiver logging into one shared baby log"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú y otro cuidador registran datos en un registro compartido del bebé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu e un’altra persona che si prende cura del bambino registrate i dati in un unico registro condiviso"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você e outro cuidador registrando em um único registro compartilhado do bebê"
          }
        }
      }
    },
    "You both log" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr tragt beide ein"
