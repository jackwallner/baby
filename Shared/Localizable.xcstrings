    "Newborn visits come often in the first month. Your log has the feeds, diapers and sleep to bring." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im ersten Monat stehen viele Vorsorgetermine an. Im Protokoll hast du Mahlzeiten, Windeln und Schlaf dabei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Newborn visits come often in the first month. Your log has the feeds, diapers and sleep to bring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las consultas del recién nacido son frecuentes durante el primer mes. Lleva tu registro de tomas, pañales y sueño."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel primo mese le visite sono frequenti. Porta il registro di poppate, pannolini e sonno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No primeiro mês, as consultas do recém-nascido são frequentes. Leve o registro de mamadas, fraldas e sono."
          }
        }
      }
    },
