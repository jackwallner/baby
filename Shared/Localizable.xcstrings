    "Hold the fabric wrong side up and run cold water through the back of the stain so it goes out the way it came in. Never hot: heat cooks milk and poop into the fibres." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Stoff mit der Innenseite nach oben und spüle den Fleck von hinten mit kaltem Wasser aus. Nimm kein heißes Wasser: Hitze setzt Milch und Stuhl in den Fasern fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the fabric wrong side up and run cold water through the back of the stain so it goes out the way it came in. Never hot: heat cooks milk and poop into the fibres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon la tela al revés y deja correr agua fría por detrás de la mancha para que salga por donde entró. Nunca uses agua caliente: el calor fija la leche y la popó en las fibras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il tessuto al rovescio e fai scorrere acqua fredda sul retro della macchia, così esce dalla stessa parte da cui è entrata. Mai acqua calda: il calore fissa latte e cacca nelle fibre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o tecido pelo avesso e passe água fria por trás da mancha, para que ela saia pelo lado por onde entrou. Nunca use água quente: o calor fixa o leite e o cocô nas fibras."
          }
        }
      }
    },
