    "Wash as warm as the care label allows, then check the garment while it is still wet. A dryer sets whatever is left, and after that it is permanent." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wasche das Kleidungsstück so warm wie laut Pflegeetikett erlaubt und prüfe es noch im nassen Zustand. Der Trockner fixiert verbleibende Flecken dauerhaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wash as warm as the care label allows, then check the garment while it is still wet. A dryer sets whatever is left, and after that it is permanent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava con el agua más caliente que permita la etiqueta y revisa la prenda mientras siga húmeda. La secadora fija cualquier resto de la mancha y después es permanente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava alla temperatura più alta consentita dall’etichetta, poi controlla il capo mentre è ancora bagnato. L’asciugatrice fissa eventuali residui della macchia, che poi diventa permanente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lave na temperatura mais alta permitida pela etiqueta e confira a peça ainda molhada. A secadora fixa o que restar da mancha, tornando-a permanente."
          }
        }
      }
    },
    "Wash, then look before it dries" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waschen und vor dem Trocknen prüfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wash, then look before it dries"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava y revisa antes de secar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lava e controlla prima che asciughi"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lave e confira antes de secar"
          }
        }
      }
    },
