            "value" : "On the other iPhone, choose Join a shared log and scan this code"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el otro iPhone, elige Unirse a un registro compartido y escanea este código"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sull'altro iPhone, scegli Accedi a un registro condiviso e scansiona questo codice"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No outro iPhone, escolha Entrar em um registro compartilhado e leia este código"
          }
        }
      }
    },
    "On their own iPhone. It's free." : {
