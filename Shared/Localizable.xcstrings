            "value" : "Uma gota de detergente"
          }
        }
      }
    },
    "A fresh start" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Anfang"
          }
        },
        "en" : {
